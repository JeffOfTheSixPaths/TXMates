# Capital One Nessie. The key stays on the server. Never prefix it with NEXT_PUBLIC_.
# Docs: https://api.nessieisreal.com/documentation
NESSIE_API_KEY=
# https works from Windows. http://api.nessieisreal.com often refuses the connection.
NESSIE_BASE_URL=https://api.nessieisreal.com
# Optional. Pin a customer from your Nessie profile. Leave blank to pick one in the form.
NESSIE_CUSTOMER_ID=
# Optional. One account id, or several separated by commas. Leave blank to use every account, or pick one in the form.
NESSIE_ACCOUNT_ID=

# Local OpenSERP. Fresh searches read SQLite first. A stale search refreshes in the background.
OPENSERP_URL=http://127.0.0.1:7000
# Default 15000. Values above 30000 are capped. Remove an older 8000 if searches still abort early.
OPENSERP_TIMEOUT_MS=15000
# Default duckduckgo,bing. Google often pushes a cold 3-engine search past the timeout.
OPENSERP_ENGINES=duckduckgo,bing
# openserp (default) or serpapi. Unset, blank, or any other value stays on OpenSERP.
SEARCH_PROVIDER=openserp
# SerpApi key. Server-side only. Never prefix it with NEXT_PUBLIC_. Leave it blank to keep OpenSERP.
# If SEARCH_PROVIDER=serpapi and this is empty, search logs a warning and uses OpenSERP.
# https://serpapi.com
SERPAPI_API_KEY=

# Optional Meta Muse Spark rationale. Without a key, plans stay on the built-in copy.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
# Default 25000. Values above 60000 are capped.
MUSE_TIMEOUT_MS=25000
# Repeat plans with the same inputs skip Muse until this many hours pass. Default 12, cap 168.
MUSE_CACHE_TTL_HOURS=12
# Outbound Muse calls per local day. Unset uses 200. An explicit value is capped at 1000, which is the ceiling, not the default. Cache hits do not count. 0 turns Muse off.
MUSE_MAX_CALLS_PER_DAY=200

# Saved OpenSERP rows live in data/txmates.db.
# How old a search can be before the next page view refreshes it. Default 8, between 1 and 24.
ACTIVITY_CACHE_TTL_HOURS=8
# Undated events are deleted this many days after they were last seen. Default 30.
ACTIVITY_EVENT_TTL_DAYS=30
# Places with no OpenSERP sighting for this many days are removed. Default 60.
ACTIVITY_PLACE_STALE_DAYS=60
# npm run refresh:activities rechecks places quiet for this many days. Default 30.
ACTIVITY_PLACE_RECHECK_DAYS=30
# How many quiet places one refresh run rechecks. Default 8, cap 50.
ACTIVITY_RECHECK_LIMIT=8
# Optional city string for the refresh script. Default Austin, TX.
ACTIVITY_LOCATION=Austin, TX

# Optional Ticketmaster Discovery API key. npm run events:collect and npm run refresh:activities
# use it to add upcoming Austin concerts, sports, and other listings. Leave it blank to keep the
# committed files in data/events as they are. Create a key at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
