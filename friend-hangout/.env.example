# Capital One Nessie. The key stays on the server. Never prefix it with NEXT_PUBLIC_.
# Docs: http://api.nessieisreal.com/documentation
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
# Optional. Pin a customer from your Nessie profile. Leave blank to pick one in the form.
NESSIE_CUSTOMER_ID=
# Optional. One account id, or several separated by commas. Leave blank to use every account, or pick one in the form.
NESSIE_ACCOUNT_ID=

# Local OpenSERP. Discovery waits this long before the Austin demo catalog.
OPENSERP_URL=http://127.0.0.1:7000
OPENSERP_TIMEOUT_MS=8000

# Optional Meta Muse Spark rationale. Without a key, plans stay on the built-in copy.
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
